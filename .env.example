# Copie para .env e ajuste. O arquivo .env NÃO vai para o git.

# development | production
NODE_ENV=development
PORT=3000
# 127.0.0.1 = só esta máquina. Para acesso externo, use um proxy reverso com HTTPS (Caddy/nginx).
HOST=127.0.0.1

# Caminho do banco SQLite (padrão: data/financas.db)
# DATABASE_PATH=./data/financas.db

# Chave de 32 bytes que criptografa as chaves de API de IA. OBRIGATÓRIA em produção.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde uma cópia segura: sem ela, as chaves de IA salvas não podem ser lidas.
APP_ENCRYPTION_KEY=

# Deixe true só até criar as contas da família; depois mude para false.
# Com false, novas contas só entram com código de convite.
ALLOW_REGISTRATION=true

# true quando estiver atrás de proxy reverso (para pegar o IP real do cliente).
TRUST_PROXY=false
# true em produção (HTTPS). Ativa cookie Secure, prefixo __Host- e HSTS.
COOKIE_SECURE=false

# Permite usar IA local via HTTP (Ollama em http://localhost:11434/v1, LM Studio...).
ALLOW_LOCAL_AI=false

# Sessão: expira após X minutos sem uso e, no máximo, após N dias.
SESSION_IDLE_MINUTES=720
SESSION_MAX_DAYS=7

# Limites anti-abuso
AUTH_ATTEMPTS_PER_15MIN=20
AI_REQUESTS_PER_HOUR=30
